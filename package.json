{
  "name": "cloud-ide-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:server": "pnpm --filter @cloud-ide/server dev",
    "dev:web": "pnpm --filter @cloud-ide/web dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
